# PostgreSQL 16 Connection
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/leadgen_db
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/leadgen_db

# Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30.0
DB_ECHO=false

# Redis & Celery Message Broker
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
INGESTION_QUEUE_NAME=leadgen_ingest_queue

# Deduplication & AI Matching
SIMILARITY_THRESHOLD=0.92
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Liveness Checking
HTTP_TIMEOUT_SECONDS=15.0
LIVENESS_CONCURRENCY=10
LIVENESS_MAX_RETRIES=2

# Transactional Notifications (Resend API)
RESEND_API_KEY=re_your_api_key_here
NOTIFICATION_EMAIL_FROM=alerts@leadgen.dev
DEADLINE_ALERT_HOURS_MIN=48
DEADLINE_ALERT_HOURS_MAX=72
